{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec_version": {
      "type": "string"
    },
    "level": {
      "type": "string",
      "enum": [
        "L1",
        "L2"
      ]
    },
    "attempt": {
      "type": "string",
      "const": "request"
    },
    "countersign": {
      "type": "string",
      "enum": [
        "none",
        "host"
      ]
    }
  },
  "required": [
    "spec_version",
    "level",
    "attempt",
    "countersign"
  ],
  "additionalProperties": false
}
