{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "session_id",
    "events"
  ],
  "additionalProperties": false
}
