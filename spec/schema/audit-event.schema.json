{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|00000000-0000-0000-0000-000000000000)$"
    },
    "spec_version": {
      "type": "string",
      "const": "auditable-mcp/0.3"
    },
    "ts": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "traceparent": {
      "type": "string"
    },
    "action_type": {
      "type": "string",
      "minLength": 1
    },
    "mutates": {
      "type": "boolean"
    },
    "egress": {
      "type": "boolean"
    },
    "target_resource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_hint": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "additionalProperties": false
    },
    "outcome": {
      "type": "string",
      "enum": [
        "attempted",
        "success",
        "failed",
        "aborted"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "hash-mismatch",
        "host-rejected",
        "host-unavailable",
        "host-uncountersigned",
        "host-signature-invalid"
      ]
    },
    "action_context": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "action_context_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signer_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "key_id": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "id",
    "spec_version",
    "ts",
    "session_id",
    "action_type",
    "mutates",
    "egress",
    "target_resource",
    "outcome"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "outcome"
        ],
        "properties": {
          "outcome": {
            "const": "aborted"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ],
  "dependentRequired": {
    "signature": [
      "key_id",
      "signer_seq"
    ],
    "key_id": [
      "signature",
      "signer_seq"
    ],
    "signer_seq": [
      "signature",
      "key_id"
    ]
  }
}
