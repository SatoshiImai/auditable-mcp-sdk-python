{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "accept"
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "record_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "host_ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "previous_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "status",
        "seq",
        "record_hash",
        "host_ts",
        "previous_hash"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "reject"
        },
        "reason": {
          "type": "string",
          "enum": [
            "schema-invalid",
            "replay-detected",
            "signature-invalid",
            "l2-unsigned",
            "unknown-key"
          ]
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unavailable"
        },
        "reason": {
          "type": "string",
          "const": "internal-error"
        },
        "retryable": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "status",
        "reason",
        "retryable"
      ],
      "additionalProperties": false
    }
  ]
}
